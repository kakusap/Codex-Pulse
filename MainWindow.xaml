<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex Pulse · 额度悬浮条" Width="560" Height="56" MinWidth="540" MinHeight="56"
        WindowStyle="None" ShowInTaskbar="False" AllowsTransparency="True" ResizeMode="CanResize" Background="Transparent" Foreground="{DynamicResource Theme.Text}"
        FontFamily="Microsoft YaHei UI" FontSize="12" UseLayoutRounding="True">
  <Window.Resources>
    <Style x:Key="PopupMenuStyle" TargetType="ContextMenu">
      <Setter Property="OverridesDefaultStyle" Value="True"/><Setter Property="HasDropShadow" Value="False"/><Setter Property="MinWidth" Value="230"/><Setter Property="MaxWidth" Value="440"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="5"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/></Border></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="PopupMenuItemStyle" TargetType="MenuItem">
      <Setter Property="OverridesDefaultStyle" Value="True"/><Setter Property="Foreground" Value="{DynamicResource Theme.Text}"/><Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem"><Border x:Name="ItemChrome" Background="{TemplateBinding Background}" CornerRadius="5" Padding="9,7"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock x:Name="Check" Text="✓" Visibility="Collapsed" Foreground="{TemplateBinding Foreground}"/><TextBlock Grid.Column="1" Text="{TemplateBinding Header}" FontSize="12" Foreground="{TemplateBinding Foreground}" TextTrimming="CharacterEllipsis"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource Theme.Hover}"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="Check" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="ItemChrome" Property="Opacity" Value="0.55"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="PopupSeparatorStyle" TargetType="Separator"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator"><Border Height="1" Margin="6,4" Background="{DynamicResource Theme.Border}"/></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Theme.Muted}"/>
      <Setter Property="Background" Value="{DynamicResource Theme.Button}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Padding" Value="10,7"/><Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="Button">
          <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Theme.Hover}"/><Setter Property="Foreground" Value="White"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.65"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Theme.Accent}"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.4"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="5"/>
      <Setter Property="Margin" Value="4,0,0,0"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
        <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical" Width="3" HorizontalAlignment="Center">
          <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton>
          <Track.Thumb><Thumb Background="{DynamicResource Theme.Edge}"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{TemplateBinding Background}" CornerRadius="2"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
          <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton>
        </Track>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ToolTip"><Setter Property="Background" Value="{DynamicResource Theme.Dialog}"/><Setter Property="Foreground" Value="{DynamicResource Theme.Text}"/><Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}"/><Setter Property="Padding" Value="10,7"/><Setter Property="HorizontalContentAlignment" Value="Center"/></Style>
  </Window.Resources>
  <Border x:Name="Surface" CornerRadius="0,0,14,14" BorderThickness="1" BorderBrush="{DynamicResource Theme.Edge}">
    <Border.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#3019283D" Offset="0"/><GradientStop Color="#28101A2B" Offset="0.55"/><GradientStop Color="#36182338" Offset="1"/></LinearGradientBrush>
    </Border.Background>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="54"/><RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Grid x:Name="DragArea" Grid.Row="0" Background="Transparent">
        <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="92"/></Grid.ColumnDefinitions>
        <Button x:Name="DragHandle" Width="22" Height="40" HorizontalAlignment="Left" Margin="2,0,0,0" Background="Transparent" BorderThickness="0" Padding="0" Cursor="SizeAll" ToolTip="拖动悬浮条" AutomationProperties.Name="拖动悬浮条"><TextBlock Text="⠿" FontSize="15" Foreground="{DynamicResource Theme.Muted}"/></Button>
        <Border Width="22" Height="25" CornerRadius="7" Background="{DynamicResource Theme.Soft}" HorizontalAlignment="Left" Margin="25,0,0,0" VerticalAlignment="Center">
          <Path Data="M 4,12 L 11,3 L 18,12 L 11,21 Z M 11,3 L 11,21" Stroke="{DynamicResource Theme.Accent}" StrokeThickness="1.3" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <StackPanel Margin="54,0,9,0" VerticalAlignment="Center"><TextBlock Text="Codex Pulse" FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold"/><Button x:Name="AccountButton" Background="Transparent" BorderThickness="0" Padding="0,2,0,0" HorizontalAlignment="Left" MaxWidth="80" ToolTip="查看所有账号额度明细" AutomationProperties.Name="全部账户额度"><StackPanel Orientation="Horizontal"><TextBlock x:Name="AccountName" Text="全部账户" MaxWidth="64" TextTrimming="CharacterEllipsis" FontSize="10"/><TextBlock Text="⌄" Margin="5,0,0,0" FontSize="10"/></StackPanel></Button></StackPanel>
        <Border Grid.Column="1" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1,0,0,0" Margin="0,12,0,12"/>
        <Button x:Name="PrimaryRingButton" Grid.Column="1" Margin="12,0,7,0" Padding="0" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" VerticalAlignment="Center" ToolTip="点击展开/收起5小时额度详情" AutomationProperties.Name="5小时额度详情"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid x:Name="PrimaryRingHost"/><StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center"><TextBlock x:Name="PrimaryLabel" Text="5 小时剩余" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="PrimaryResetText" Text="正在读取" FontSize="9" Foreground="{DynamicResource Theme.Muted}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></Grid></Button>
        <Border Grid.Column="2" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1,0,0,0" Margin="0,15,0,15"/>
        <Button x:Name="SecondaryRingButton" Grid.Column="2" Margin="12,0,7,0" Padding="0" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" VerticalAlignment="Center" ToolTip="点击展开/收起7天额度详情" AutomationProperties.Name="7天额度详情"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid x:Name="SecondaryRingHost"/><StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center"><TextBlock x:Name="SecondaryLabel" Text="7 天剩余" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="SecondaryResetText" Text="正在读取" FontSize="9" Foreground="{DynamicResource Theme.Muted}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></Grid></Button>
        <Border Grid.Column="3" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1,0,0,0" Margin="0,12,0,12"/>
        <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"><Button x:Name="PinButton" Padding="5,5" ToolTip="切换窗口置顶 (Ctrl+T)" AutomationProperties.Name="切换窗口置顶"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE718;" FontSize="11"/><TextBlock x:Name="PinText" Text="置顶" Margin="5,0,0,0" FontSize="9"/></StackPanel></Button><Button x:Name="MenuButton" Content="⋯" Padding="4,4" Background="Transparent" BorderThickness="0" FontSize="18" ToolTip="展开用量与热力图" AutomationProperties.Name="展开或收起用量与热力图"/></StackPanel>
      </Grid>
      <Grid x:Name="DetailsPanel" Grid.Row="1" Visibility="Collapsed" Margin="22,0,22,14">
      <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="32"/></Grid.RowDefinitions>
      <DockPanel Grid.Row="0" Margin="0,0,0,8"><TextBlock Text="用量与账户详情" FontSize="13" VerticalAlignment="Center"/><Button x:Name="CollapseButton" DockPanel.Dock="Right" HorizontalAlignment="Right" Content="收起" Padding="8,3" Background="Transparent" BorderThickness="0" ToolTip="收起为悬浮条"/></DockPanel>
      <Border x:Name="UsageSummaryCard" Grid.Row="1" CornerRadius="14" Background="{DynamicResource Theme.Card}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1" Padding="17,14" Margin="0,0,0,17">
        <StackPanel>
          <DockPanel LastChildFill="True">
            <Button x:Name="KeyButton" DockPanel.Dock="Right" Padding="7,2" FontSize="10" ToolTip="筛选当前来源中的账号" Content="全部账号 ▾"/>
            <TextBlock x:Name="UsageTotalTitle" Text="可统计 Token" Foreground="{DynamicResource Theme.Muted}" FontSize="11" VerticalAlignment="Center"/>
          </DockPanel>
          <StackPanel Orientation="Horizontal" Margin="0,1,0,0"><TextBlock x:Name="UsedText" Text="—" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="37" FontWeight="SemiBold"/><TextBlock x:Name="UsedUnit" Text="" Foreground="{DynamicResource Theme.Muted}" FontSize="13" VerticalAlignment="Bottom" Margin="7,0,0,9"/></StackPanel>
          <Grid Margin="0,11,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock x:Name="LimitTitle" Text="订阅额度" Foreground="{DynamicResource Theme.Muted}" FontSize="10"/><TextBlock x:Name="RemainingText" Text="读取中…" Foreground="{DynamicResource Theme.Accent}" FontSize="16" FontWeight="Medium" Margin="0,4,0,0"/></StackPanel>
            <Button x:Name="CostDetailsButton" Grid.Column="1" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Padding="0" ToolTip="查看本机参考费用、覆盖范围及未计价原因" AutomationProperties.Name="本机参考费用详情">
              <StackPanel><TextBlock x:Name="CostTitle" Text="本机参考费用" Foreground="{DynamicResource Theme.Muted}" FontSize="10" HorizontalAlignment="Right"/><TextBlock x:Name="CostText" Text="—" FontFamily="Segoe UI" FontSize="17" Margin="0,3,0,0" HorizontalAlignment="Right"/><TextBlock x:Name="CostCoverage" Text="等待本机明细" Foreground="{DynamicResource Theme.Muted}" FontSize="9" Margin="0,3,0,0" HorizontalAlignment="Right" MaxWidth="250" TextTrimming="CharacterEllipsis"/></StackPanel>
            </Button>
          </Grid>
          <TextBlock x:Name="QuotaNote" Text="正在连接本地数据源" Foreground="{DynamicResource Theme.Muted}" FontSize="10" Margin="0,11,0,0" TextWrapping="Wrap" MaxHeight="32" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
      </Border>
      <Border Grid.Row="2" Padding="12,10" CornerRadius="12" Background="{DynamicResource Theme.Card}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1" Margin="0,0,0,17">
        <StackPanel>
          <DockPanel Margin="0,0,0,9"><TextBlock Text="Token 使用热力图" FontSize="12" FontWeight="SemiBold"/><TextBlock x:Name="UsageDateBasis" DockPanel.Dock="Right" Text="近一年 · 北京时间" Foreground="{DynamicResource Theme.Muted}" FontSize="9" HorizontalAlignment="Right"/></DockPanel>
          <Grid x:Name="HeatmapHost"/>
        </StackPanel>
      </Border>
      <Grid Grid.Row="3" Margin="0,0,0,4">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel><TextBlock Text="账户额度" Foreground="#D8E5F9" FontSize="12" FontWeight="SemiBold"/><TextBlock x:Name="AccountCount" DockPanel.Dock="Right" Foreground="{DynamicResource Theme.Muted}" FontSize="10" HorizontalAlignment="Right"/></DockPanel>
        <TextBlock Grid.Row="1" Text="Codex 账号 · 以最近查询结果为准" Foreground="{DynamicResource Theme.Muted}" FontSize="9" Margin="0,4,0,0"/>
        <ScrollViewer Grid.Row="2" x:Name="AccountsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,10,0,0"><StackPanel x:Name="AccountsPanel"/></ScrollViewer>
      </Grid>
      <Grid Grid.Row="4" Margin="0,11,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse x:Name="SyncDot" Fill="#6FD6AB" Width="4" Height="4" Margin="0,0,6,0"/><TextBlock x:Name="SyncText" Text="读取本地数据…" Foreground="{DynamicResource Theme.Muted}" FontSize="9"/></StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="RefreshButton" ToolTip="刷新 (F5)" Padding="6,2" Background="Transparent" BorderThickness="0" AutomationProperties.Name="刷新"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72C;" FontSize="11"/></Button><Button x:Name="SettingsButton" ToolTip="设置" Padding="6,2" Background="Transparent" BorderThickness="0" AutomationProperties.Name="设置"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" FontSize="11"/></Button></StackPanel>
      </Grid>
    </Grid>
    </Grid>
  </Border>
</Window>
